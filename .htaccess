# ADA LAW Chambers — cache control
#
# Problem this solves: browsers cache .css and .js files aggressively
# by default, so after uploading an updated admin.js or style.css to
# Hostinger, visitors (including you, in the admin panel) can keep
# seeing the OLD version until they hard-refresh or clear their cache.
#
# Fix: tell browsers to always check back with the server before
# using a cached copy of CSS/JS ("must-revalidate"). If the file
# hasn't changed, the server replies with a tiny "304 Not Modified"
# and the browser uses its cached copy — fast, no re-download. If the
# file HAS changed (you re-uploaded it), the browser gets the fresh
# version immediately. Either way, you never see a stale file again.
#
# Images/fonts are left on a normal long cache since they rarely
# change and don't cause this kind of bug when they're stale.

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # 7 days: fast repeat visits (a page-speed / SEO signal) while a
  # replaced image still shows up within a week. To update an image
  # instantly, upload it under a NEW filename and point the page at it.
  <FilesMatch "\.(jpg|jpeg|png|gif|svg|webp|ico|woff|woff2)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

# ---------------------------------------------------------------
# Old blog post links now go to post.php instead of post.html, so
# link-preview bots (WhatsApp, Facebook, etc.) see the real per-post
# title/image instead of a generic one. This keeps any already-
# shared post.html?slug=... links working by sending them to the
# same post on post.php instead of a broken/blank page.
# ---------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # One address for the whole site: https://www.adalawchambers.com.
  # The bare domain and the Hostinger preview domain serve the same
  # files, which search engines would otherwise index as duplicates.
  # (http -> https is already handled by Hostinger, so only the host
  # is checked here — checking HTTPS behind Hostinger's CDN can loop.)
  RewriteCond %{HTTP_HOST} ^adalawchambers\.com$ [NC,OR]
  RewriteCond %{HTTP_HOST} \.hostingersite\.com$ [NC]
  RewriteRule ^ https://www.adalawchambers.com%{REQUEST_URI} [R=301,L]

  # /sitemap.xml is generated by sitemap.php (lists posts from the DB).
  RewriteRule ^sitemap\.xml$ sitemap.php [L]

  RewriteCond %{QUERY_STRING} ^slug=(.*)$
  RewriteRule ^post\.html$ /post.php?slug=%1 [R=301,L]

  # Public pages are built on the server by render.php (header, footer,
  # breadcrumbs and database lists filled in) so search engines see the
  # whole page. The address stays the same .html URL. Only top-level
  # pages that exist are routed; /admin/ and everything else is untouched.
  # (No QSA: the visitor's own query string must not choose the page.)
  RewriteRule ^$ render.php?page=index [L]
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^([a-z0-9-]+)\.html$ render.php?page=$1 [L]
</IfModule>

# Friendly "Page not found" page for any missing URL.
ErrorDocument 404 /404.html
